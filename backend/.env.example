# PlacementOS Backend Configuration
APP_ENV=local
DATABASE_URL=sqlite:///./placementos.db
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Auth Configuration (Supabase or custom JWT)
AUTH_ISSUER_URL=https://<project-ref>.supabase.co/auth/v1
AUTH_AUDIENCE=authenticated
SUPABASE_JWT_SECRET=your-jwt-secret-placeholder

# Storage Configuration
SUPABASE_STORAGE_BUCKET=resumes
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-placeholder

# Upload limits
MAX_RESUME_BYTES=5242880
